---
interface Props {
  title: string;
  hideFooter?: boolean;
}
const { title, hideFooter = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&display=swap"
    />
    <style is:global>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; border: 0 solid; }
      :root {
        --bg: #edf1f7;
        --bg-card: #f8fafe;
        --b9: #1b2d6b;
        --b8: #243b8a;
        --b7: #3050a5;
        --b6: #3d63c2;
        --b5: #5078d4;
        --b4: #6b90e0;
        --b3: #92ade8;
        --b2: #b8ccf2;
        --b1: #d6e3f8;
        --b0: #eaf0fb;
        --tp: #1b2d6b;
        --ts: #4a5e8a;
        --tm: #7889ac;
        --serif: "Fraunces", Georgia, serif;
        --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        --cw: 1080px;
        --pad: 24px;
      }
      html { scroll-behavior: smooth; }
      body {
        font-family: var(--serif);
        background: var(--bg);
        color: var(--tp);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
        overflow-x: hidden;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      a { color: inherit; text-decoration: none; }
      button { font: inherit; color: inherit; background: none; cursor: pointer; }
      img, svg, video { display: block; max-width: 100%; }

      .rails {
        position: fixed;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        display: none;
      }
      @media (min-width: 1024px) {
        .rails { display: block; }
      }
      .rails-inner {
        position: relative;
        height: 100%;
        max-width: var(--cw);
        margin: 0 auto;
        padding: 0 var(--pad);
      }
      .rails-inner::before,
      .rails-inner::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        width: 1px;
        background: var(--b1);
      }
      .rails-inner::before { left: var(--pad); }
      .rails-inner::after  { right: var(--pad); }

      .nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 0;
        background: rgba(237, 241, 247, 0.88);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--b2);
      }
      .nav-inner {
        width: var(--cw);
        max-width: 100%;
        margin: 0 auto;
        padding: 0 var(--pad);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--serif);
        font-weight: 500;
        font-size: 16px;
        color: var(--b9);
      }
      .btn {
        display: inline-block;
        font-family: var(--serif);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #fff;
        background: var(--b6);
        border-radius: 6px;
        padding: 9px 18px;
        font-size: 11px;
        transition: background-color .2s, filter .2s, scale .2s;
      }
      .btn:hover { background: var(--b7); }
      .btn:active { filter: brightness(.75); scale: .97; }
      .btn-lg {
        position: relative;
        overflow: hidden;
        font-size: 13px;
        padding: 14px 28px;
        transition: filter .3s, scale .3s;
      }
      .btn-lg::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--b8);
        transform: translateX(-101%);
        transition: transform .3s cubic-bezier(0, 0, .2, 1);
        border-radius: 6px;
      }
      .btn-lg:hover::before { transform: translateX(0); }
      .btn-lg > span { position: relative; z-index: 1; }

      .page {
        padding-top: 86px;
        flex: 1;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 2;
      }
      @media (min-width: 1024px) {
        .page { padding-top: 95px; }
      }
      .container {
        width: 100%;
        max-width: var(--cw);
        margin: 0 auto;
        padding: 0 var(--pad);
      }

      .footer {
        position: relative;
        z-index: 2;
        max-width: var(--cw);
        margin: 0 auto;
        padding: 12px var(--pad);
        width: 100%;
      }
      .footer-rule {
        height: 1px;
        background: var(--b1);
        margin-bottom: 10px;
      }
      .footer-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
      }
      .footer a {
        font-family: var(--serif);
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--tm);
        text-align: center;
        transition: color .2s;
      }
      .footer a:hover { color: var(--b6); }

      .eyebrow {
        font-family: var(--serif);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 11px;
        color: var(--tm);
      }
      h1, h2, h3 {
        font-family: var(--serif);
        font-weight: 500;
        color: var(--b9);
        letter-spacing: -0.02em;
        line-height: 1.3;
      }
      p { color: var(--ts); line-height: 1.5; }

      .code-block {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--bg-card);
        border: 1px solid var(--b1);
        border-radius: 6px;
        padding: 10px 14px;
        font-family: var(--mono);
        font-size: 13px;
        white-space: nowrap;
      }
      .code-block code {
        color: var(--b7);
        user-select: all;
        white-space: nowrap;
      }
      .copy-btn {
        padding: 4px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        color: var(--tm);
        transition: color .15s;
      }
      .copy-btn:hover { color: var(--b6); }
    </style>
  </head>
  <body>
    <div class="rails" aria-hidden="true"><div class="rails-inner"></div></div>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="brand">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 12 L2 2 L12 2 Q2 2 2 12 Z" fill="white" opacity="0.8"></path>
            <path d="M2 12 L2 2 L12 2" stroke="#5078D4" stroke-width="1.5" fill="none"></path>
            <path d="M2 12 Q2 2 12 2" stroke="#92ADE8" stroke-width="1.5" fill="none"></path>
          </svg>
          spandrel
        </a>
        <a href="/getting-started" class="btn">Get Started</a>
      </div>
    </nav>
    <main class="page">
      <slot />
    </main>
    {!hideFooter && (
      <footer class="footer">
        <div class="footer-rule"></div>
        <div class="footer-grid">
          <a href="/demo">Demo</a>
          <a href="/getting-started">Get Started</a>
        </div>
      </footer>
    )}
  </body>
</html>
