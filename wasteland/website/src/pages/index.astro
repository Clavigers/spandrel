---
import Base from '../layouts/Base.astro';
---
<Base title="spandrel — grit for your build">
  <section class="hero container">
    <div class="eyebrow">A sharper build tool</div>
    <h1>
      Build faster.<br />
      With a little <strong>grit</strong>.
    </h1>
    <p class="lede">
      Spandrel is a zero-config build runner that scrapes away<br class="br-lg" />
      everything slow about your pipeline.
    </p>

    <div class="install">
      <div class="code-block">
        <code id="install-cmd">curl https://spandrel.dev/get | sh</code>
        <button class="copy-btn" aria-label="Copy to clipboard">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 010 1.5h-1.5a.25.25 0 00-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 00.25-.25v-1.5a.75.75 0 011.5 0v1.5A1.75 1.75 0 019.25 16h-7.5A1.75 1.75 0 010 14.25z"/>
            <path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0114.25 11h-7.5A1.75 1.75 0 015 9.25zm1.75-.25a.25.25 0 00-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 00.25-.25v-7.5a.25.25 0 00-.25-.25z"/>
          </svg>
        </button>
      </div>
      <a href="/get_abrasive" class="more">More installation methods &rarr;</a>
    </div>

    <div class="ctas">
      <a href="/demo" class="btn-lg btn"><span>See Demo</span></a>
      <a href="/getting-started" class="btn-lg btn"><span>Get Started</span></a>
    </div>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding-top: 48px;
    padding-bottom: 48px;
  }
  h1 {
    font-size: clamp(36px, 5vw, 60px);
    color: var(--b8);
    margin-bottom: 20px;
  }
  h1 strong {
    font-weight: 700;
    color: var(--b9);
  }
  .lede {
    font-size: 18px;
    color: var(--ts);
    max-width: 640px;
    margin: 0 auto 32px;
  }
  .br-lg { display: none; }
  @media (min-width: 1024px) { .br-lg { display: inline; } }

  .install {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 28px;
  }
  .more {
    margin-top: 8px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tm);
    transition: color .2s;
  }
  .more:hover { color: var(--b6); }

  .ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.copy-btn')!;
  const code = document.getElementById('install-cmd')!;
  const copyIcon = btn.innerHTML;
  const checkIcon = '<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg>';
  btn.addEventListener('click', () => {
    navigator.clipboard.writeText(code.textContent!);
    btn.innerHTML = checkIcon;
    setTimeout(() => { btn.innerHTML = copyIcon; }, 2000);
  });
</script>
